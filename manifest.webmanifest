{
  "name": "Golden Eagle Academy — Aviation English (ICAO)",
  "short_name": "Golden Eagle",
  "description": "Installable Aviation English exam portal for Golden Eagle Academy, aligned to the ICAO language proficiency levels.",
  "lang": "en",
